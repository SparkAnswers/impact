          },
          "scenarioId": "random_walk",
          "alias": "temp",
          "startValue": 21,
          "spread": 1,
          "noise": 0.2,
          "min": -10,
          "max": 40
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "min": -10,
          "max": 40
        },
        "overrides": []
      },
      "options": {
        "startAngle": 210,
        "sweepAngle": 120,
        "clockwise": true,
        "scale": "linear",
        "showHistory": false,
        "animate": false,
        "positiveColor": "red",
        "negativeColor": "blue",
        "valueFontSize": 56,
        "secondaryText": "Range {value}",
        "secondaryReducer": "range",
        "subtitleText": "Over the visible range",
        "titleText": "Temperature",
        "titlePosition": "hidden"
      }
    },
    {
      "id": 8,
      "type": "sparkanswers-impact-gauge-panel",
      "title": "Transparent background",
      "description": "Grafana's panel option Transparent background is on: the gauge paints no background of its own, so the dashboard shows through.",
