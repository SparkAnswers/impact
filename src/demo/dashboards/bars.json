        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "updated",
                "destinationType": "time"
              }
            ]
          }
        }
      ],
      "options": {
        "barStyle": "percent",
        "colorMode": "thresholds",
        "showCheckbox": true,
        "showStatusDot": true,
        "defaultSortField": "",
        "labelPosition": "right",
        "trackWidth": 150,
        "trackHeight": 6,
        "radius": 3,
        "animationSpeed": 1.6,
        "sweepWidth": 38,
        "segments": 10,
        "density": "comfortable",
        "showFooter": true,
        "stackFields": [
          "progress"
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "text": "Healthy",
                        "color": "green",
                        "icon": "check-circle",
                        "index": 0
                      },
                      "warn": {
                        "text": "Degraded",
                        "color": "orange",
                        "icon": "exclamation-triangle",
                        "index": 1
                      },
                      "crit": {
                        "text": "Critical",
                        "color": "red",
                        "icon": "times-circle",
                        "index": 2
                      },
                      "updating": {
