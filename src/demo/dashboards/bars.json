        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "${DS_TESTDATA}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "${DS_TESTDATA}"
          },
          "refId": "A",
          "scenarioId": "csv_content",
